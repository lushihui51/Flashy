{% extends "base.jinja" %}

{% block title %}Create Deck Configuration - Flashy{% endblock %}

{% block content %}
<input id="check_deck_id">
<button onclick="loadDeck()">Check Deck</button>
<pre id="check_deck_info"></pre>

<script>
    async function loadDeck() {
        const id = document.getElementById('check_deck_id').value;
        const res = await fetch(`/api/decks/deck/${id}`);
        const data = await res.json();
        document.getElementById('check_deck_info').textContent = JSON.stringify(data, null, 2);
    }
</script>

<h1>Create Deck Configuration</h1>
<form method="post" action="/page/deck_configs/deck_config/create">
    <label for="deck_id">Deck:</label>
    <input type="text" id="deck_id" name="deck_id">
    <label for="prompt_fields">Prompt Fields:</label>
    <input type="text" id="prompt_fields" name="prompt_fields">
    <label for="answer_fields">Answer Fields:</label>
    <input type="text" id="answer_fields" name="answer_fields">
    <label for="prompt_pool">Prompt Pool:</label>
    <input type="text" id="prompt_pool" name="prompt_pool">
    <label for="prompt_pool_counts">Prompt Pool Counts:</label>
    <input type="text" id="prompt_pool_counts" name="prompt_pool_counts">
    <label for="answer_pool">Answer Pool:</label>
    <input type="text" id="answer_pool" name="answer_pool">
    <label for="answer_pool_counts">Answer Pool Counts:</label>
    <input type="text" id="answer_pool_counts" name="answer_pool_counts">
    <button type="submit">Create Deck Configuration</button>
</form>
{% endblock %}